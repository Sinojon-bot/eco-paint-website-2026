rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Хониш барои ҳама (сайт/телефон)
    // Навиштан: ё Google-и админ, ё syncKey аз админ-панел
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasSyncKey();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasSyncKey();
    }
    match /customers/{uid} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

function isAdmin() {
  return request.auth != null
    && request.auth.token.email == 'sinoitojirsandora@gmail.com'
    && request.auth.token.email_verified == true;
}

function hasSyncKey() {
  return request.resource != null
    && request.resource.data.syncKey == 'EcoPaintTJ2026Sync';
}
